# Application defaults. Copy to .env before a source or Compose deployment.
PORT=3000
NODE_ENV=development
MAX_FILE_SIZE=52428800
DB_PATH=./database/platform.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=false
TRUST_PROXY=0

# Docker image and direct HTTP binding.
STATIC_HOST_IMAGE=docker.io/epiphany131/static-site-showcase
IMAGE_TAG=1.0.0
DEPLOY_MODE=http
HTTP_BIND=127.0.0.1
HTTP_PORT=3000

# Required only for docker-compose.production.yml.
PLATFORM_ORIGIN=
ACME_EMAIL=
